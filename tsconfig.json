{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "types": [
      "node"
    ],
    "useDefineForClassFields": true
  },
  "exclude": [
    "_attic",
    "**/node_modules",
    "**/lib"
  ]
}