{
  "name": "@deepseek-ai/dsh-llm",
  "description": "Provider-neutral LLM service interface for the DeepSeek Harness",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./brand": {
      "types": "./src/brand.ts",
      "default": "./src/brand.ts"
    },
    "./message": {
      "types": "./src/message.ts",
      "default": "./src/message.ts"
    },
    "./assistant-stream": {
      "types": "./src/assistant-stream.ts",
      "default": "./src/assistant-stream.ts"
    },
    "./typert": {
      "types": "./src/typert.host.ts",
      "default": "./src/typert.host.ts"
    },
    "./remote": {
      "types": "./src/typert.remote-client.ts",
      "default": "./src/typert.remote-client.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-crypto": "*",
    "@deepseek-ai/schemastery": "*",
    "zod": "4.4.3",
    "@deepseek-ai/dsh-timeout": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-util-values": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/cordis": "*"
  }
}