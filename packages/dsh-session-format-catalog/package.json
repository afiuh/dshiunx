{
  "name": "@deepseek-ai/dsh-session-format-catalog",
  "description": "Build-static first-party Session format codec and migration catalog",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-format-catalog"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./message-projections": {
      "types": "./src/message-projections.ts",
      "default": "./src/message-projections.ts"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-session-format": "*",
    "@deepseek-ai/dsh-session-format-v0-to-v1": "*",
    "@deepseek-ai/dsh-session-format-v1-to-v2": "*",
    "@deepseek-ai/dsh-session-format-v2-to-v3": "*",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "*",
    "@deepseek-ai/dsh-compaction-image-offload": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-session": "*"
  }
}