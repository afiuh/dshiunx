{
  "name": "@deepseek-ai/dsh-tool-subagent-control",
  "description": "Globally named send_message, interrupt_agent, and list_agents tools over ctx.subagents continuations",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/tool-subagent-control"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./list-agents": {
      "types": "./src/list-agents.ts",
      "default": "./src/list-agents.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./list-agents/locale/*.json": "./locale/list-agents/*.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-loop": "*",
    "@deepseek-ai/dsh-agent-loop-testkit": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-persistence": "*",
    "@deepseek-ai/dsh-session-persistence-jsonl": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-session-query": "*",
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-subagent-fork-in-process": "*",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-util-values": "*"
  }
}