{
  "name": "@deepseek-ai/dsh-session-format-v2-to-v3",
  "description": "Streaming system-prompt, canonical-envelope and PTC migration into V3",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-format-v2-to-v3"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dsh": {
    "sessionFormatMigration": {
      "from": 2,
      "to": 3,
      "export": ".",
      "migration": "sessionFormatV2ToV3",
      "sourceCodec": "releasedV2SessionFormatCodec",
      "targetCodec": "releasedV3SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV3Header",
      "targetRestorer": "restoreReleasedV3Artifact"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-format": "*",
    "@deepseek-ai/dsh-session-format-v0-to-v1": "*",
    "@deepseek-ai/dsh-session-format-v1-to-v2": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*"
  }
}