{
  "name": "@deepseek-ai/dsh-tool-subagent",
  "description": "Model-facing subagent delegation tool over the ctx.subagents seam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/tool-subagent"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./model-selection-settings": {
      "types": "./src/model-selection-settings.ts",
      "default": "./src/model-selection-settings.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./model-selection-settings/locale/*.json": "./locale/model-selection-settings/*.json"
  },
  "license": "MIT",
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    }
  }
}
