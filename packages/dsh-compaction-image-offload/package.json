{
  "name": "@deepseek-ai/dsh-compaction-image-offload",
  "description": "Durable image offload for image-capable routes: replace over-budget request images with placeholders and retry",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/compaction/compaction-image-offload"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./projection": {
      "types": "./src/projection.ts",
      "default": "./src/projection.ts"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-loop": "*",
    "@deepseek-ai/dsh-agent-loop-testkit": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-compaction-basic": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-llm-deepseek": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-token-meter": "*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "*"
  }
}