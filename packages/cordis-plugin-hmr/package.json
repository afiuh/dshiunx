{
  "name": "@deepseek-ai/cordis-plugin-hmr",
  "description": "Hot Module Replacement Plugin for Cordis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "vendor/hmr"
  },
  "type": "module",
