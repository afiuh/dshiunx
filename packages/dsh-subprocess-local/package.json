{
  "name": "@deepseek-ai/dsh-subprocess-local",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runner": {
      "types": "./src/bin.ts",
      "default": "./src/runner.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./output": {
      "types": "./src/output.ts",
      "default": "./src/output.ts"
    },
    "./locale/*.json": "./locale/*.json"
  }
}
