{
  "name": "@deepseek-ai/dsh-commands",
  "description": "Plugin-owned human command registry for DeepSeek Harness UIs",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/interaction/commands"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./brand": {
      "types": "./src/brand.ts",
      "default": "./src/brand.ts"
    },
    "./typert": {
      "types": "./src/typert.host.ts",
      "default": "./src/typert.host.ts"
    },
    "./remote": {
      "types": "./src/typert.remote-client.ts",
      "default": "./src/typert.remote-client.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/cordis": "*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-crypto": "*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-brand": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-scope": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/cordis": "*"
  }
}