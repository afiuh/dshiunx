{
  "name": "@deepseek-ai/dsh-plugin-manager",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/types/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types/types.ts",
      "default": "./src/types/types.ts"
    },
    "./registry": {
      "types": "./src/types/registry.ts",
      "default": "./src/types/registry.ts"
    },
    "./typert": {
      "types": "./src/typert.host.ts",
      "default": "./src/typert.host.ts"
    },
    "./remote": {
      "types": "./src/typert.remote-client.ts",
      "default": "./src/typert.remote-client.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./src/types/operations.ts",
      "default": "./src/types/operations.ts"
    },
    "./tools": {
      "types": "./src/tools.ts",
      "default": "./src/tools.ts"
    },
    "./tools/locale/*.json": "./locale/tools/*.json",
    "./locale/*.json": "./locale/*.json"
  }
}